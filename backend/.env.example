# Copy to .env and fill in real values before running.

PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/tradepulse

# Broker API credentials — obtain by registering a developer app with
# each broker. Never commit real keys to git.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
DHAN_ACCESS_TOKEN=
UPSTOX_API_KEY=

# Market data provider (licensed feed — NOT free/scraped)
MARKET_DATA_PROVIDER_KEY=

# AI provider for strategy generation / journal Q&A
AI_PROVIDER_API_KEY=

JWT_SECRET=change_this_to_a_long_random_string
